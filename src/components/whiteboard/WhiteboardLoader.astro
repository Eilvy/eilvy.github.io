---
import Whiteboard from './Whiteboard.tsx';
import type { El } from './scene-kit';

interface Props {
	/** 场景元素（纯数据） */
	elements: El[];
	/** 无障碍标签 / 图表说明 */
	label: string;
	/** 点击前占位区高度（px）。刻意比展开后小，避免正文里一个大空框占太多篇幅 */
	placeholderHeight?: number;
	/** 加载后内嵌画布高度（px） */
	height?: number;
	/** 占位按钮上的文案 */
	buttonText?: string;
}

const {
	elements,
	label,
	placeholderHeight = 200,
	height = 380,
	buttonText = '点击加载流程图',
} = Astro.props;
---

{/*
  点击加载（click-to-load）。

  Excalidraw 主 chunk 约 1.1MB（gzip 约 361KB），若直接用
  <Whiteboard client:only="react" />，打开文章时就会下载执行 ——
  哪怕读者根本不看这张图。这里把 island 放进 <template>：
  模板内容不参与渲染、不会连接 DOM，因此 island 的 connectedCallback
  不会触发、组件也不会被 import，直到读者点击后把它克隆进页面。

  ─ 为什么不用手动 import('./Whiteboard.tsx') ─
  一开始是自己 document.createElement + import() 挂载的，生产环境正常，
  但 `astro dev` 下必然失败，报：
    @vitejs/plugin-react can't detect preamble. Something is wrong.
  原因是 Vite 的 React Fast Refresh 需要一个 preamble（$RefreshReg$ 等），
  @astrojs/react 是把它作为 before-hydration 脚本、以「每个 island 一个
  before-hydration-url 属性」的形式注入的（见 astro/dist/runtime/server/
  hydration.js）。只有经 Astro 渲染流程产出的 island 才会带上这个属性；
  手动 import 绕过了整条链路，拿不到 preamble，dev 下 React 模块一加载就抛错。

  改用 <template> + 克隆后，island 由 Astro 正常产出（自带 before-hydration-url），
  克隆进 DOM 时它会自己先加载 preamble 再 hydrate，dev / prod 都能跑；
  同时「不点击就不连接」也天然保证了懒加载。
*/}
<div class="wb-loader" data-state="idle">
	<div class="wb-placeholder" style={`min-height:${placeholderHeight}px`}>
		<button type="button" class="wb-btn">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M21 21l-4.35-4.35"></path>
			</svg>
			<span class="wb-btn-label">{buttonText}</span>
			<span class="wb-hint">约 1MB，按需加载</span>
		</button>
	</div>

	<div class="wb-status" role="status">
		<span class="wb-spinner" aria-hidden="true"></span>
		<span class="wb-status-text">正在加载画板…</span>
	</div>
	<div class="wb-mount"></div>

	{/* island 存放在模板里，点击后才克隆到 .wb-mount */}
	<template class="wb-tpl">
		<Whiteboard client:only="react" elements={elements} height={height} label={label} />
	</template>
</div>

<script>
	/*
	 * 把被 <template> 关住的 Astro 引导脚本「请」出来执行。
	 *
	 * ── 问题 ──
	 * 页面里有多个画板时，Astro 只会输出一次 island 运行时脚本
	 * （定义 self.Astro.only 与 customElements.define('astro-island')），
	 * 而它恰好被排在了**第一个** <template> 内部。
	 * <template> 的内容是惰性的：脚本不会执行，元素也不参与渲染。
	 * 于是：
	 *   - 直接点最后一个画板 → 克隆出的 <astro-island> 是未知元素，
	 *     没有任何逻辑处理它，画板不加载（但占位按钮已隐藏，看起来像卡住）；
	 *   - 之后倒序点到第一个画板 → 引导脚本随克隆进入真实 DOM 并执行，
	 *     自定义元素被注册，浏览器会**追溯升级**此前已插入的所有
	 *     <astro-island>，于是一瞬间全部加载出来。
	 * 这正是「必须点到第一个才全部出现」的原因。
	 *
	 * ── 修法 ──
	 * 在插入 island 之前，先把引导脚本从模板里取出来执行一次
	 * （只做一次，用 data 标记）。脚本本身是幂等的（重复定义自定义元素
	 * 会抛错，所以必须只执行一次），执行后所有画板就能各自独立加载，
	 * 点哪个都不会影响其他。
	 */
	const ensureIslandRuntime = () => {
		if (document.documentElement.dataset.wbRuntimeReady === '1') return;
		const tpl = document.querySelector<HTMLTemplateElement>('.wb-tpl');
		if (!tpl) return;
		// 模板内、<astro-island> 之前的 <script> 即 Astro 的引导脚本
		const bootstrap: HTMLScriptElement[] = [];
		for (const node of Array.from(tpl.content.childNodes)) {
			if (node.nodeType === Node.ELEMENT_NODE) {
				const el = node as Element;
				if (el.tagName === 'SCRIPT') bootstrap.push(el as HTMLScriptElement);
				if (el.tagName === 'ASTRO-ISLAND') break;
			}
		}
		for (const old of bootstrap) {
			// 模板里的 script 克隆出来不会执行，需重建一个新节点
			const s = document.createElement('script');
			s.textContent = old.textContent;
			document.head.appendChild(s);
		}
		document.documentElement.dataset.wbRuntimeReady = '1';
	};

	document.querySelectorAll<HTMLElement>('.wb-loader').forEach((root) => {
		root.querySelector('.wb-btn')?.addEventListener('click', () => {
			const tpl = root.querySelector<HTMLTemplateElement>('.wb-tpl');
			const mount = root.querySelector<HTMLElement>('.wb-mount');
			if (!tpl || !mount) return;

			// 先确保 island 运行时已就绪，否则克隆出来的元素没人认领
			ensureIslandRuntime();

			/*
			 * 先切到 loading（显示 spinner），等画板**真正渲染出来**再切 ready。
			 *
			 * 为什么不能直接切 ready：Excalidraw 主 chunk 约 1.1MB，
			 * 从「island 接入 DOM」到「画布画出来」有一段时间（dev 下尤其明显，
			 * 因为模块是逐个未打包请求的）。这段时间 .wb-mount 里是空的，
			 * 若已切 ready 就会露出一块空白 —— 这正是要修的观感问题。
			 *
			 * 判定「渲染好了」用 .whiteboard（React 组件根节点）出现为准，
			 * 它出现就意味着 React 已挂载、Excalidraw 已开始渲染。
			 */
			root.dataset.state = 'loading';

			const reveal = () => {
				root.dataset.state = 'ready';
			};

			// 用 MutationObserver 而不是轮询：更及时，也不用管清理时机
			const mo = new MutationObserver(() => {
				if (mount.querySelector('.whiteboard')) {
					mo.disconnect();
					reveal();
				}
			});
			mo.observe(mount, { childList: true, subtree: true });

			mount.appendChild(tpl.content.cloneNode(true));

			// 兜底：万一观察不到（例如结构变化），4 秒后无条件显示，避免一直转圈
			setTimeout(() => {
				mo.disconnect();
				if (root.dataset.state === 'loading') reveal();
			}, 4000);
		});
	});
</script>

<style>
	.wb-loader {
		margin: 1.5em 0;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		overflow: hidden;
	}

	/* 默认全部隐藏，由 data-state 精确点亮其中一个，保证互斥且不留占位高度 */
	.wb-loader > .wb-placeholder,
	.wb-loader > .wb-status,
	.wb-loader > .wb-mount {
		display: none;
	}

	.wb-loader[data-state='idle'] > .wb-placeholder,
	.wb-loader[data-state='loading'] > .wb-status {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75em;
		padding: 1.25em;
		background-color: var(--color-bg-secondary);
		/* 与占位按钮的最小高度对齐，避免切换时高度跳变 */
		min-height: 120px;
	}

	.wb-loader[data-state='ready'] > .wb-mount {
		display: block;
	}

	/*
	 * 加载态：转圈 + 文案。
	 * 用 border 画的圆环（无图片、无 JS），并用 currentColor 跟随主题，
	 * 这样浅色/暗色都不用另写一套颜色。
	 */
	.wb-status-text {
		font-size: 0.875rem;
		color: var(--color-text-light);
	}

	.wb-spinner {
		width: 22px;
		height: 22px;
		border: 2px solid var(--color-border);
		border-top-color: var(--color-primary);
		border-radius: 50%;
		animation: wb-spin 0.7s linear infinite;
	}

	@keyframes wb-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* 尊重「减少动态效果」偏好：不转圈，改为静态提示 */
	@media (prefers-reduced-motion: reduce) {
		.wb-spinner {
			animation: none;
			border-top-color: var(--color-border);
			border-left-color: var(--color-primary);
		}
	}

	/* 占位期的按钮做得克制些：不抢正文注意力 */
	.wb-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 1.1em;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-primary);
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 9999px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.wb-btn:hover {
		border-color: var(--color-primary);
		background-color: var(--color-primary-light);
	}

	.wb-btn svg {
		width: 16px;
		height: 16px;
	}

	.wb-hint {
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--color-text-light);
	}
</style>

<style is:global>
	/*
	 * Excalidraw 的汉堡菜单按钮在 viewMode 下并未被它自带的样式隐藏
	 * （.excalidraw--view-mode 只调整了 .App-menu 的布局），
	 * 会在左下角留下一个点不开的悬浮按钮。这里显式去掉。
	 */
	.wb-mount .main-menu-trigger,
	.wb-mount .App-menu_top,
	.wb-mount .App-bottom-bar {
		display: none !important;
	}

	/* astro-island 默认 display: contents，需要它撑满容器交给 Excalidraw 量尺寸 */
	.wb-mount astro-island {
		display: block;
		height: 100%;
	}
</style>
