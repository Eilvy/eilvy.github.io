---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { SITE_TITLE } from '../consts';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description?: string;
	image?: string | ImageMetadata;
	canonicalURL?: string;
	type?: 'website' | 'article';
	publishedDate?: string;
	author?: string;
	tags?: string[];
}

const { 
	title, 
	description, 
	image, 
	canonicalURL,
	type,
	publishedDate,
	author,
	tags
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<!-- 立即执行的主题检测脚本，防止 FOUC - 必须在 CSS 加载前执行 -->
		<script>
			/*
			 * 主题初始化。必须在 CSS 之前执行以防 FOUC，
			 * 因此放在 head 的内联脚本里（Header 不再重复这套逻辑）。
			 */
			function applyTheme() {
				const savedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const dark = savedTheme === 'dark' || (!savedTheme && prefersDark);
				
				// 用 toggle 而不是只 add：这样「系统偏好变了」或
				// 从暗色导航回浅色时也能正确复原，不会残留上一次的类
				document.documentElement.classList.toggle('dark', dark);
				
				// 标记主题已加载，移除 visibility: hidden
				document.documentElement.classList.add('theme-loaded');
			}
			
			// 页面加载时立即执行
			applyTheme();
			
			// 监听 View Transition 导航，确保主题不丢失
			document.addEventListener('astro:after-swap', function() {
				applyTheme();
			});
		</script>
		
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!--
			订阅源自动发现声明。
			浏览器与 RSS 阅读器据此自动找到订阅地址（否则在 Feedly 之类里
			输入网址会提示「未找到订阅源」，必须手动填 /rss.xml）。
			此前这两行随 BaseHead.astro 一起被误删，这里补回。
		-->
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<!-- Preconnect to fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<SEO 
			title={title} 
			description={description} 
			image={image} 
			canonicalURL={canonicalURL}
			type={type}
			publishedDate={publishedDate}
			author={author}
			tags={tags}
		/>
		{/*
			无 JS 兜底：主题脚本不会执行，.theme-loaded 永不出现，
			若不覆盖就会整页空白。详见上方 <style> 里的说明。
		*/}
		<noscript>
			<style>
				/*
				 * 必须 !important：这段样式位于 head 中、早于 Astro 注入的
				 * 样式表（它们用 <link> 追加在 <head> 末尾），
				 * 同优先级下后者胜出，覆盖会失效（实测确认）。
				 */
				html:not(.theme-loaded) {
					visibility: visible !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<a href="#main-content" class="skip-link">跳转到主要内容</a>
		<slot />
	</body>
</html>

<style is:global>
	/* 防止 FOUC - 主题加载前隐藏页面 */
	/*
	 * 防 FOUC：主题脚本执行前先隐藏页面，避免「先亮色再跳暗色」的闪烁。
	 *
	 * ⚠️ 但这会造成一个隐患：如果 JS 被禁用或脚本报错，.theme-loaded
	 * 永远不会被加上 —— 页面将**永久空白**。
	 * （实测：禁用 JS 后整页 invisible，这是之前就存在的问题。）
	 *
	 * 下面的 <noscript> 覆盖是兜底：无 JS 时直接显示内容。
	 * 代价是无 JS 用户会看到未应用主题的亮色版本 —— 远比空白页好。
	 */
	html:not(.theme-loaded) {
		visibility: hidden;
	}
	
	/* Skip link for accessibility */
	.skip-link {
		position: absolute;
		top: -40px;
		left: 0;
		background: var(--color-primary);
		color: white;
		padding: 8px 16px;
		z-index: 100;
		transition: top 0.3s;
	}
	
	.skip-link:focus {
		top: 0;
	}
</style>
