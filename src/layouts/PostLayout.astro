---
import BlogLayout from './BlogLayout.astro';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tag from '../components/Tag.astro';
import type { BlogPostData } from '../types/blog';

const { title, description, pubDate, updatedDate, tags, categories, heroImage, author } = Astro.props as BlogPostData;

// 仅当确实发生过更新时才显示「更新于」，
// 避免 frontmatter 里写上与 pubDate 相同的 updatedDate 时出现冗余展示
const hasUpdate = !!updatedDate && updatedDate.valueOf() !== pubDate.valueOf();

/*
 * heroImage 归一化为 ImageMetadata。
 *
 * 常态是「已经是对象」：src/content.config.ts 里 heroImage 用 image() 校验，
 * 内容集合在加载时就把 frontmatter 的字符串路径转成了 ImageMetadata。
 *
 * 保留字符串分支只为了兼容未经 image() 处理的调用方；这里不再维护
 * 一长串路径猜测逻辑（原先分支覆盖 5 种写法，实际数据只用
 * '../../assets/xxx.jpg' 一种），改为直接用 import.meta.glob 拿到
 * assets 目录下全部图片，按文件名匹配。这样既覆盖各种相对/绝对写法，
 * 也不需要动态 import 表达式（后者会给 Vite 带来 dynamic-import-vars 告警）。
 */
const assetImages = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp,avif}', {
	eager: true,
});

function resolveHeroImage(path?: string | ImageMetadata): ImageMetadata | undefined {
	if (!path) return undefined;
	if (typeof path === 'object') return path;

	// 取路径最后一段作为文件名，与 assets 下的键名比对
	const name = path.split('/').pop();
	if (!name) return undefined;
	const hit = Object.keys(assetImages).find((key) => key.endsWith(`/${name}`));
	if (!hit) {
		console.warn(`heroImage 未在 src/assets 中找到：${path}`);
		return undefined;
	}
	return assetImages[hit].default;
}

const heroImageMetadata = resolveHeroImage(heroImage);
---

<BlogLayout 
	title={title} 
	description={description}
	image={heroImageMetadata}
	type="article"
	publishedDate={pubDate?.toISOString()}
	author={author}
	tags={tags}
>
	<div class="post-layout">
		<main class="article-main">
			<article class="prose">
				<header class="post-header">
					{heroImageMetadata && (
						<div class="hero-image">
							<img src={heroImageMetadata.src} alt={title} />
						</div>
					)}
					
					<h1>{title}</h1>
					
					<div class="post-meta">
						<div class="meta-left">
							<FormattedDate date={pubDate} compact />
							{hasUpdate && updatedDate && (
								<span class="updated-date">
									· 更新于 <FormattedDate date={updatedDate} compact />
								</span>
							)}
							{author && <span class="author">· {author}</span>}
						</div>
						
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<Tag name={tag} />
								))}
							</div>
						)}
					</div>
				</header>
				
				<div class="post-content">
					<slot />
				</div>
				
				<footer class="post-footer">
					{categories && categories.length > 0 && (
						<div class="categories">
							<span class="label">分类：</span>
							{categories.map((category: string) => (
								<Tag name={category} />
							))}
						</div>
					)}
				</footer>
			</article>
		</main>
		
		<aside class="toc-sidebar">
			<slot name="toc" />
		</aside>
	</div>
</BlogLayout>

<style>
	.post-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 3em;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2em 1em;
	}
	
	.toc-sidebar {
		position: sticky;
		top: 100px;
		height: fit-content;
	}
	
	.article-main {
		min-width: 0;
	}
	
	@media (max-width: 1024px) {
		.post-layout {
			grid-template-columns: 1fr;
			max-width: 720px;
		}
		
		.toc-sidebar {
			display: none;
		}
	}
</style>

<style>
	.post-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}
	
	h1 {
		font-size: 2.5rem;
		line-height: 1.2;
		margin-bottom: 1rem;
		color: var(--color-text);
	}
	
	.post-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		color: var(--color-text-light);
		font-size: 0.875rem;
	}
	
	.meta-left {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	
	.tags, .categories {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	
	.categories .label {
		font-weight: 500;
	}
	
	.hero-image {
		margin-bottom: 2rem;
	}
	
	.hero-image img {
		width: 100%;
		max-height: 400px;
		object-fit: cover;
		border-radius: 12px;
	}
	
	.post-content {
		margin: 2rem 0;
	}
	
	.post-footer {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}
	
	@media (max-width: 768px) {
		h1 {
			font-size: 1.875rem;
		}
		
		.post-meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
